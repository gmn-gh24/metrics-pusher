<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0 is the current LTS (supported to Nov 2028); net8.0 went out of support on
         10 Nov 2026. This matters more than usual here because every publish is
         self-contained: the runtime is baked into the exe and gets no Windows Update
         servicing, so the only patch path for a runtime CVE is rebuilding this project.
         .NET 10 also stopped adding the executable's directory to the native-library search
         path in single-file apps, which is a second lock on the same door
         Services/SystemLibraryResolver.cs closes. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>1.0.1</Version>
    <FileVersion>1.0.1</FileVersion>
    <AssemblyVersion>1.0.1</AssemblyVersion>
    <!-- Keep win-x64 in the restore graph so plain builds and self-contained publishes
         resolve the same package set (prevents churn between the two commands) -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <!-- The publish shape lives here, not only on the command line, for the same reason
         RuntimeIdentifiers does: restore must resolve one package set. Single-file publish
         pulls in Microsoft.NET.ILLink.Tasks, so with the shape only on the command line the
         lock file gained that entry on every publish and lost it on every plain restore.
         Neither property affects "dotnet build" - both are read at publish time. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- NVAPI and NVML are 64-bit only; pinning the platform target means even an
         AnyCPU-configured build produces a 64-bit assembly. -->
    <Platforms>AnyCPU;x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Runtime knobs: this app allocates roughly one small payload per second and
         gains nothing from the background GC thread; R2R removes JIT work at startup.
         Property names are ConcurrentGarbageCollection / ServerGarbageCollection (not
         ...Collector) - MSBuild ignores unknown properties silently, so verify the
         emitted System.GC.* keys in the published MetricsPusher.runtimeconfig.json. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Code Analysis -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <!-- Reproducible release builds. Without this the compiler embeds absolute source
         paths, so the same commit built from two different directories produces two
         different binaries. The exe is unsigned, so a byte-identical rebuild is the only
         way anyone can verify a downloaded MetricsPusher.exe really is this source.
         Release only: it rewrites source paths, which would break local debugging. -->
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release'">true</ContinuousIntegrationBuild>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- Supply chain: the lock file pins the whole transitive closure so two machines build
         the same bytes, and the audit fails restore on a known-vulnerable package rather
         than picking it up quietly. Mode "all" covers transitive deps, not just direct. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
  </PropertyGroup>

  <!-- Every service is internal; the test project reads them directly -->
  <ItemGroup>
    <InternalsVisibleTo Include="MetricsPusher.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\trayicon.ico" />
    <!-- PawnIO assets, embedded so the exe stays a single copy-and-run file. The two .bin
         modules are RSA-signed Pawn bytecode from PawnIO.Modules 0.2.10, redistributed
         unmodified under LGPL-2.1-or-later - COPYING is that licence text and must ship
         with them. PawnIO_setup.exe is the 2.2.0 driver installer, extracted and run only
         when the user accepts the first-run prompt. Refreshing these is one atomic task:
         replace all three module-release files together and re-record the SHA-256s in
         README.md. Manifest names are path-derived, e.g.
         MetricsPusher.Resources.PawnIo.IntelMSR.bin. -->
    <EmbeddedResource Include="Resources\PawnIo\IntelMSR.bin" />
    <EmbeddedResource Include="Resources\PawnIo\AMDFamily17.bin" />
    <EmbeddedResource Include="Resources\PawnIo\COPYING" />
    <EmbeddedResource Include="Resources\PawnIO_setup.exe" />
  </ItemGroup>

  <!-- Exclude the test project subfolder from compilation -->
  <ItemGroup>
    <Compile Remove="MetricsPusher.Tests\**" />
    <Content Remove="MetricsPusher.Tests\**" />
    <EmbeddedResource Remove="MetricsPusher.Tests\**" />
    <None Remove="MetricsPusher.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NvAPIWrapper.Net" Version="0.8.1.101" />
    <PackageReference Include="Roslynator.Analyzers" Version="4.12.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="StyleCop.Analyzers" Version="1.1.118">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>
